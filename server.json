{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "link.aotrust/notary",
  "title": "AOTrust Notarization & Evidence Server",
  "description": "Cryptographic proof of existence for AI agents. x402 on Base or Solana, NEAR anchored. Free tier.",
  "repository": {
    "url": "https://github.com/GitSerge-crypto/aotrust-skills",
    "source": "github"
  },
  "homepage": "https://docs.aotrust.link",
  "license": "MIT",
  "version": "2.5.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "aotrust-protocol",
      "version": "2.5.0",
      "transport": {
        "type": "streamable-http",
        "url": "https://api.aotrust.link/mcp"
      },
      "environmentVariables": [
        {
          "name": "AOTRUST_BASE_URL",
          "description": "AOTrust API base URL",
          "isRequired": false,
          "isSecret": false,
          "default": "https://api.aotrust.link/v1"
        }
      ]
    },
    {
      "registryType": "npm",
      "identifier": "aotrust-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AOTRUST_API_KEY",
          "description": "Optional: leave empty for the free tier",
          "isRequired": false,
          "isSecret": true,
          "default": ""
        }
      ]
    }
  ]
}
